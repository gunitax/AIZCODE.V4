////////////////////////////////////////////////////////////////////////////////
// Подсистема "Сообщения в службу технической поддержки".
// ОбщийМодуль.СообщенияВСлужбуТехническойПоддержкиКлиент.
//
// Клиентские процедуры и функции отправки сообщений в 
// службу технической поддержки:
//  - подготовка вложений сообщений;
//  - отправка сообщений на Портал 1С:ИТС;
//  - переход на страницу отправки сообщений.
//
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Открывает страницу Портала 1С:ИТС для отправки сообщения в службу технической поддержки.
// При настроенной подсистеме Информационный центр, сообщение передается в Информационный центр.
// В параметрах передаются данные заполнения, вложения и параметры выгрузки журнала регистрации.
//
// Параметры:
//  ДанныеСообщения - Структура - данные для формирования сообщения,
//                    См. СообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения;
//  Вложения - Массив Из Структура, Неопределено - файлы вложений.  Важно: допускаются только
//             текстовые вложения (*.txt, *.json, *.xml). При передаче адреса во временном хранилище
//             данные должны быть помещены с уникальным идентификатором. Поля структуры элемента вложения:
//    *Представление - Строка - представление вложения. Например, "Вложение 1.txt";
//    *ВидДанных - Строка - определяет преобразование переданных данных.
//                Возможна передача одного из значений:
//                  - ИмяФайла - Строка - полное имя файла вложения;
//                  - Адрес - Строка - адрес во временном хранилище значения типа ДвоичныеДанные;
//                  - Текст - Строка - текст вложения;
//    *Данные - Строка - данные для формирования вложения;
//  ОтборЖурналаРегистрации - Структура, Неопределено - настройки выгрузки журнала регистрации:
//    *ДатаНачала    - Дата - начало периода журнала;
//    *ДатаОкончания - Дата - конец периода журнала;
//    *События       - Массив - список событий;
//    *Метаданные    - Массив, Неопределено - массив метаданных для отбора;
//    *Уровень       - Строка - уровень важности событий журнала регистрации. Возможные значения:
//       - "Ошибка" - будет выполнен отбор по событиям с УровеньЖурналаРегистрации.Ошибка;
//       - "Предупреждение" - будет выполнен отбор по событиям с УровеньЖурналаРегистрации.Предупреждение;
//       - "Информация" - будет выполнен отбор по событиям с УровеньЖурналаРегистрации.Информация;
//       - "Примечание" - будет выполнен отбор по событиям с УровеньЖурналаРегистрации.Примечание.
//  ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - метод, в который должен быть
//                          передан результат отправки сообщения. В метод передается значение типа
//                          Структура - результат отправки сообщения:
//                            *КодОшибки - Строка - идентификатор ошибки при отправки:
//                                                   - <Пустая строка> - отправка выполнена успешно;
//                                                   - "НеверныйФорматЗапроса" - переданы некорректные параметры
//                                                      сообщения в техническую поддержку;
//                                                   - "НеизвестнаяОшибка" - при отправке сообщения возникли ошибки;
//                                                   - "НеизвестнаяОшибкаСервиса" - при отправке сообщения возникли
//                                                      проблемы с сервисом;
//                                                   - "ОтсутствуетОбязательныйПараметрЗапроса" - отсутствует
//                                                      обязательный параметр сообщения в техническую поддержку;
//                                                   - "ОшибкаФайловойСистемы" - ошибка файловой системы;
//                                                   - "ПревышенМаксимальныйРазмерВложения" - превышен максимальный
//                                                      размер вложения;
//                                                   - "ПревышенМаксимальныйРазмерЖурналаРегистрации" - превышен
//                                                      максимальный размер журнала регистрации;
//                                                   - "ПустойПараметрЗапроса" - не заполнен обязательный параметр
//                                                      сообщения в техническую поддержку;
//                            *СообщениеОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке
//                                                 для пользователя.
//
Процедура ОтправитьСообщение(
		ДанныеСообщения,
		Вложения = Неопределено,
		ОтборЖурналаРегистрации = Неопределено,
		ОповещениеОЗавершении = Неопределено) Экспорт
	
	Результат = СообщенияВСлужбуТехническойПоддержкиКлиентСервер.РезультатПроверкиПараметровОтправки(
		ДанныеСообщения,
		Вложения,
		ОтборЖурналаРегистрации);
	
	Если ЗначениеЗаполнено(Результат.КодОшибки) Тогда
		
		Если ОповещениеОЗавершении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(
				ОповещениеОЗавершении,
				Результат);
		Иначе
			
			ПараметрыСообщения = Новый Структура;
			ПараметрыСообщения.Вставить("ДанныеСообщения",         ДанныеСообщения);
			ПараметрыСообщения.Вставить("Вложения",                Вложения);
			ПараметрыСообщения.Вставить("ОтборЖурналаРегистрации", ОтборЖурналаРегистрации);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ТекстСообщения",     Результат.СообщениеОбОшибке);
			ПараметрыФормы.Вставить("ПараметрыСообщения", ПараметрыСообщения);
			
			ОткрытьФорму(
				"ОбщаяФорма.ОшибкаСообщенияВСлужбуТехническойПоддержки",
				ПараметрыФормы);
			
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Состояние(
		,
		,
		НСтр("ru = 'Подготовка сообщения в службу технической поддержки'"));
	
	ПодготовитьТехническуюИнформацию(ДанныеСообщения);
	
	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить("ДанныеСообщения",         ДанныеСообщения);
	ПараметрыСообщения.Вставить("Вложения",                Вложения);
	ПараметрыСообщения.Вставить("ОтборЖурналаРегистрации", ОтборЖурналаРегистрации);
	ПараметрыСообщения.Вставить("ОповещениеОЗавершении",   ОповещениеОЗавершении);
	
	ПодготовитьВложенияКОтправке(ПараметрыСообщения);
	
КонецПроцедуры

// Открывает страницу Портала 1С:ИТС для отправки сообщения в службу технической поддержки.
// При настроенной подсистеме Информационный центр, сообщение передается в Информационный центр.
// Требуется использовать при вызове СообщенияВСлужбуТехническойПоддержки.ПодготовитьСообщение.
// В параметрах передается результат подготовки сообщения в техническую поддержку.
//
// Параметры:
//  СообщениеВСлужбуТехническойПоддержки - Структура - данные для формирования сообщения,
//    См. СообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения;
//  ДополнительныеПараметры - Структура, Неопределено - дополнительные параметры для отправки сообщения:
//    * ОповещениеОЗавершении - ОписаниеОповещения, Неопределено - метод, в который должен быть
//        передан результат отправки сообщения. Если не передано, тогда нужно самостоятельно
//        оповещать пользователя об ошибках. В метод передается значение типа:
//              Структура - результат отправки сообщения:
//                * КодОшибки - Строка - идентификатор ошибки при отправки:
//                   - <Пустая строка> - отправка выполнена успешно;
//                   - "НеверныйФорматЗапроса" - переданы некорректные параметры
//                      сообщения в техническую поддержку;
//                   - "НеизвестнаяОшибка" - при отправке сообщения возникли ошибки;
//                   - "НеизвестнаяОшибкаСервиса" - при отправке сообщения возникли проблемы с сервисом;
//                   - "ОтсутствуетОбязательныйПараметрЗапроса" - отсутствует
//                      обязательный параметр сообщения в техническую поддержку;
//                   - "ОшибкаФайловойСистемы" - ошибка файловой системы;
//                   - "ПревышенМаксимальныйРазмерВложения" - превышен максимальный размер вложения;
//                   - "ПревышенМаксимальныйРазмерЖурналаРегистрации" - превышен максимальный размер
//                      журнала регистрации;
//                   - "ПустойПараметрЗапроса" - не заполнен обязательный параметр сообщения 
//                      в техническую поддержку;
//                * СообщениеОбОшибке - Строка, ФорматированнаяСтрока - сообщение об ошибке для пользователя.
//
Процедура Отправить(
		СообщениеВСлужбуТехническойПоддержки,
		ДополнительныеПараметры = Неопределено) Экспорт
	
	ПараметрыСообщения = Новый Структура("ОповещениеОЗавершении");
	Если ДополнительныеПараметры <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыСообщения, ДополнительныеПараметры);
	КонецЕсли;
	
	Если СообщениеВСлужбуТехническойПоддержки.ИспользуетсяИнформационныйЦентр Тогда
		ОтправитьСообщениеВИнформационныйЦентр(
			СообщениеВСлужбуТехническойПоддержки.СообщениеВИнформационныйЦентр,
			ПараметрыСообщения.ОповещениеОЗавершении);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеВСлужбуТехническойПоддержки.КодОшибки) Тогда
		Если ПараметрыСообщения.ОповещениеОЗавершении <> Неопределено Тогда
			
			ПриЗавершенииОбработкиСообщения(
				ПараметрыСообщения,
				СообщениеВСлужбуТехническойПоддержки);
			
		КонецЕсли;
		
	Иначе
		
		ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта(
			СообщениеВСлужбуТехническойПоддержки.URLСтраницы,
			НСтр("ru = 'Отправка сообщения в службу технической поддержки'"));
		
		ПриЗавершенииОбработкиСообщения(
			ПараметрыСообщения,
			СообщениеВСлужбуТехническойПоддержки);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет техническую информацию клиентской части.
//
// Параметры:
//  ДанныеСообщения - Структура - данные для формирования сообщения,
//                    См. СообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения.
//
Процедура ПодготовитьТехническуюИнформацию(ДанныеСообщения)
	
	ДанныеТехническойИнформации = ДанныеСообщения.ДанныеТехническойИнформации;
	СообщенияВСлужбуТехническойПоддержкиКлиентСервер.ЗаполнитьСистемнуюИнформацию(
		ДанныеТехническойИнформации.СистемнаяИнформацияКлиента);
	
КонецПроцедуры

// Отправляет вложения на сервер и вызывает метод подготовки сообщения.
//
// Параметры:
//  ПараметрыСообщения - Структура - данные для отправки сообщения.
//
Процедура ПодготовитьВложенияКОтправке(ПараметрыСообщения)
	
	ПомещаемыеФайлы = Новый Массив;
	Если ПараметрыСообщения.Вложения <> Неопределено Тогда
		Для Каждого Вложение Из ПараметрыСообщения.Вложения Цикл
			Если Вложение.ВидДанных = "ИмяФайла" Тогда
				ПередаваемыйФайл = Новый ОписаниеПередаваемогоФайла(Вложение.Данные);
				ПомещаемыеФайлы.Добавить(ПередаваемыйФайл);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ПомещаемыеФайлы.Количество() = 0 Тогда
		ПодготовитьВложенияКОтправкеЗавершение(
			Неопределено,
			ПараметрыСообщения);
	Иначе
		
		ПараметрыСообщения.Вставить("ПомещаемыеФайлы", ПомещаемыеФайлы);
		
		ПараметрыЗагрузки = ФайловаяСистемаКлиент.ПараметрыЗагрузкиФайла();
		ПараметрыЗагрузки.Интерактивно = Ложь;
		
		ФайловаяСистемаКлиент.ЗагрузитьФайлы(
			Новый ОписаниеОповещения(
				"ПодготовитьВложенияКОтправкеЗавершение",
				ЭтотОбъект,
				ПараметрыСообщения),
			ПараметрыЗагрузки,
			ПомещаемыеФайлы);
		
	КонецЕсли;
	
КонецПроцедуры

// Помещает вложения во временное хранилище и вызывает метод подготовки сообщения.
//
// Параметры:
//  ФайлыВложений - Неопределено - пользователь отказался от выбора или файл занят другой программой.
//                - Массив из Структура - пользователь выбрал файл. См. ФайловаяСистемаКлиент.ЗагрузитьФайлы.
//  ПараметрыСообщения - Структура - данные для отправки сообщения.
//
Процедура ПодготовитьВложенияКОтправкеЗавершение(
		ФайлыВложений,
		ПараметрыСообщения) Экспорт
	
	ИсходныеЗначения = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПараметрыСообщения.Вложения);
	
	Если ФайлыВложений <> Неопределено Тогда
		Для Каждого Вложение Из ПараметрыСообщения.Вложения Цикл
			Если Вложение.ВидДанных = "ИмяФайла" Тогда
				Для Каждого Файл Из ФайлыВложений Цикл
					Если Файл.ПолноеИмя = Вложение.Данные Тогда
						// Замена вида данных на адрес во временном хранилище.
						Вложение.ВидДанных = "Адрес";
						Вложение.Данные = Файл.Хранение;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Результат = СообщенияВСлужбуТехническойПоддержкиВызовСервера.ПодготовитьСообщение(
		ПараметрыСообщения.ДанныеСообщения,
		ПараметрыСообщения.Вложения,
		ПараметрыСообщения.ОтборЖурналаРегистрации);
		
	Если Результат.ИспользуетсяИнформационныйЦентр
		И Не ЗначениеЗаполнено(Результат.КодОшибки) Тогда
		ОтправитьСообщениеВИнформационныйЦентр(
			Результат.СообщениеВИнформационныйЦентр,
			ПараметрыСообщения.ОповещениеОЗавершении,
			ФайлыВложений);
		Возврат;
	КонецЕсли;
	
	// Очистка сеансовых данных после отправки сообщения.
	ОчиститьВременныеФайлы(ФайлыВложений);
	
	Если ИсходныеЗначения <> Неопределено Тогда
		ПараметрыСообщения.Вложения.Очистить();
		ПараметрыСообщения.Вложения = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ИсходныеЗначения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат.КодОшибки) Тогда
		ОбработатьОшибкуОтправки(Результат, ПараметрыСообщения);
		Возврат;
	КонецЕсли;
		
	ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта(
		Результат.URLСтраницы,
		НСтр("ru = 'Отправка сообщения в службу технической поддержки'"));
	
	ПриЗавершенииОбработкиСообщения(
		ПараметрыСообщения,
		Результат);
	
КонецПроцедуры

// Выполняется обработку ошибки отправки сообщения:
// - Если в параметрах задано описание оповещения, то вызывается соответствующая процедура.
// - Если обработка оповещения не указана, то открывается типовая форма с сообщением об ошибке.
//
// Параметры:
//  Результат - См. СообщенияВСлужбуТехническойПоддержки.НовыйРезультатПодготовкиСообщения.
//  ПараметрыСообщения - Структура - данные для отправки сообщения.
//
// ВозвращаемоеЗначение:
//  Булево - признак наличия ошибок.
Процедура ОбработатьОшибкуОтправки(Результат, ПараметрыСообщения)
	
	Если ПараметрыСообщения.ОповещениеОЗавершении = Неопределено Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекстСообщения",     Результат.СообщениеОбОшибке);
		ПараметрыФормы.Вставить("ПараметрыСообщения", ПараметрыСообщения);
		
		ОткрытьФорму(
			"ОбщаяФорма.ОшибкаСообщенияВСлужбуТехническойПоддержки",
			ПараметрыФормы);
		
	Иначе
		
		ПриЗавершенииОбработкиСообщения(
			ПараметрыСообщения,
			Результат);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗавершенииОтправкиСообщенияВТехПоддержку(Параметры, ДополнительныеПараметры) Экспорт
	
	ОчиститьВременныеФайлы(ДополнительныеПараметры.ВременныеФайлы);
	ОчиститьВременныеФайлы(
		ДополнительныеПараметры.Вложения,
		Ложь,
		"АдресВоВременномХранилище");

	Если ДополнительныеПараметры.ОписаниеОповещения <> Неопределено Тогда
		Результат = Новый Структура;
		Результат.Вставить("КодОшибки",         "");
		Результат.Вставить("СообщениеОбОшибке", "");
			
		ЗаполнитьЗначенияСвойств(
			Результат,
			ДополнительныеПараметры,
			"КодОшибки, СообщениеОбОшибке");
			
		ВыполнитьОбработкуОповещения(
			ДополнительныеПараметры.ОписаниеОповещения,
			Результат);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтправитьСообщениеВИнформационныйЦентр(
		СообщениеВИнформационныйЦентр,
		ОповещениеОЗавершении,
		ВременныеФайлы = Неопределено)
	
	Если Не ОбщегоНазначенияКлиент.ПодсистемаСуществует("ТехнологияСервиса.ИнформационныйЦентр") Тогда
		ОчиститьВременныеФайлы(ВременныеФайлы);
		ОчиститьВременныеФайлы(
			СообщениеВИнформационныйЦентр.Вложения,
			Ложь,
			"АдресВоВременномХранилище");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОписаниеОповещения", ОповещениеОЗавершении);
	ДополнительныеПараметры.Вставить("КодОшибки",          "");
	ДополнительныеПараметры.Вставить("СообщениеОбОшибке",  "");
	ДополнительныеПараметры.Вставить("Вложения",           СообщениеВИнформационныйЦентр.Вложения);
	ДополнительныеПараметры.Вставить("ВременныеФайлы",     ВременныеФайлы);
	
	СообщениеВИнформационныйЦентр.ОбработчикЗавершения = Новый ОписаниеОповещения(
		"ПриЗавершенииОтправкиСообщенияВТехПоддержку",
		ЭтотОбъект,
		ДополнительныеПараметры);
	
	МодульИнформационныйЦентрКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнформационныйЦентрКлиент"); // АПК:271 Ранее проверка существования подсистемы
	ПараметрыОбращения = МодульИнформационныйЦентрКлиент.НовыеПараметрыОбращенияВСлужбуПоддержки();
	ЗаполнитьЗначенияСвойств(
		ПараметрыОбращения,
		СообщениеВИнформационныйЦентр);
	МодульИнформационныйЦентрКлиент.ОткрытьФормуНовогоОбращенияВСлужбуПоддержки(ПараметрыОбращения);
	
КонецПроцедуры

Процедура ПриЗавершенииОбработкиСообщения(ПараметрыСообщения, РезультатОтправки)
	
	Если ПараметрыСообщения.ОповещениеОЗавершении <> Неопределено Тогда
		
		Результат = Новый Структура;
		Результат.Вставить("КодОшибки",         "");
		Результат.Вставить("СообщениеОбОшибке", "");
		
		ЗаполнитьЗначенияСвойств(
			Результат,
			РезультатОтправки,
			"КодОшибки, СообщениеОбОшибке");
		
		ВыполнитьОбработкуОповещения(
			ПараметрыСообщения.ОповещениеОЗавершении,
			Результат);
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает имя события для журнала регистрации
//
// Возвращаемое значение:
//  Строка - имя события.
//
Функция ИмяСобытияЖурналаРегистрации()
	
	Возврат НСтр("ru = 'Сообщения в службу технической поддержки'",
		ОбщегоНазначенияКлиент.КодОсновногоЯзыка());
	
КонецФункции

// См. СообщенияВСлужбуТехническойПоддержки.ПриОпределенииКомандПодключенныхКОбъекту
//
Процедура Подключаемый_СообщениеВСлужбуТехническойПоддержки(ПараметрКоманды, Контекст) Экспорт
	
	ПараметрыСообщения = Новый Структура;
	ПараметрыСообщения.Вставить(
		"ДанныеСообщения",
		СообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения());
	ПараметрыСообщения.Вставить("Вложения", Неопределено);
	ПараметрыСообщения.Вставить("ОтборЖурналаРегистрации", Неопределено);
	ПараметрыСообщения.Вставить("ОповещениеОЗавершении", Неопределено);
	ПараметрыСообщения.Вставить("Отправить", Ложь);
	
	ИнтеграцияПодсистемБИПКлиент.ПриОпределенииПараметровСообщенияСлужбуТехническойПоддержки(
		ПараметрыСообщения,
		Контекст);
	СообщенияВСлужбуТехническойПоддержкиКлиентПереопределяемый.ПриОпределенииПараметровСообщенияСлужбуТехническойПоддержки(
		ПараметрыСообщения,
		Контекст);

	Если ПараметрыСообщения.Отправить Тогда
		
		ОтправитьСообщение(
			ПараметрыСообщения.ДанныеСообщения,
			ПараметрыСообщения.Вложения,
			ПараметрыСообщения.ОтборЖурналаРегистрации,
			ПараметрыСообщения.ОповещениеОЗавершении);
	Иначе
		ДанныеСообщения = СообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения();
		ДанныеСообщения.Получатель = "v8";
		ОтправитьСообщение(
			ДанныеСообщения);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет очистку временных файлов, помещенных во временное хранилище.
// Удаляются только файлы, созданные в процессе работы подсистемы. Файлы, помещенные во временное хранилище
// прикладной логикой для отправки сообщения в тех. поддержку, не изменяются.
// 
// Параметры:
//  Вложения - Массив Из Структура - описание файлов вложений.
//  Все - Булево - если Истина, то будут очищены все файлы. Если Ложь, то только те, у которых значение свойства
//    Очищать установлено в Истина.
//  ИмяПоляАдрес - Строка - имя поля описания файла вложения, в котором храниться адрес во временном хранилище.
//
Процедура ОчиститьВременныеФайлы(
		Вложения,
		Все = Истина,
		ИмяПоляАдрес = "Хранение")
	
	Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	Для Каждого Файл Из Вложения Цикл
		Попытка
			Если Все Или Файл.Очищать Тогда
				УдалитьИзВременногоХранилища(Файл[ИмяПоляАдрес]);
			КонецЕсли;
		Исключение
			ЕстьОшибки = Истина;
		КонецПопытки;
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		ЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации(
			ИмяСобытияЖурналаРегистрации(),
			"Предупреждение",
			НСтр("ru = 'Не все временные файлы были удалены. Возможно, они были удалены ранее.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
