# Запросы к сервису objects. Адрес, авторизация и идентификаторы — в .env рядом.
# Пока обработчики не реализованы, каждый запрос отвечает 501.

### Найти тип — все виды
GET {{$dotenv OBJECTS_URL}}/types
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти тип по слову «валют»
GET {{$dotenv OBJECTS_URL}}/types?q=валют
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти тип по слову «поступлен»
GET {{$dotenv OBJECTS_URL}}/types?q=поступлен
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать тип — справочник
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоПартнеры
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать тип — документ
GET {{$dotenv OBJECTS_URL}}/type?name=Документ._ДемоСчетНаОплатуПокупателю
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать тип — служебный справочник вне допуска
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник.Пользователи
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описать тип — неизвестный тип
GET {{$dotenv OBJECTS_URL}}/type?name=ТакогоНет
Authorization: {{$dotenv OBJECTS_AUTH}}

### Найти объекты типа
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=Альфа
Authorization: {{$dotenv OBJECTS_AUTH}}

### Прочитать объект
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id={{$dotenv PARTNER_ID}}
Authorization: {{$dotenv OBJECTS_AUTH}}

### Создать объект — тело запроса задаёт ваша спецификация
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{}
